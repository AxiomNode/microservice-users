SERVICE_NAME=microservice-users
SERVICE_PORT=7100
NODE_ENV=development

# Monitoring
METRICS_LOG_BUFFER_SIZE=500

# Private docs (Swagger-like) for internal testing
PRIVATE_DOCS_ENABLED=true
PRIVATE_DOCS_PREFIX=/private/docs
PRIVATE_DOCS_TOKEN=users_private_docs_token

# Firebase auth verification (required when FIREBASE_STRICT_AUTH=true)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative to the 3 vars above:
# FIREBASE_CREDENTIALS_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# Strict mode must stay true in production.
# Set false only for local development/testing.
FIREBASE_STRICT_AUTH=true

# Bootstrap del unico SuperAdmin (opcional, recomendado en produccion)
SUPERADMIN_FIREBASE_UID=

# Persistent storage
DATABASE_URL=postgresql://users:users@localhost:7434/usersdb?schema=public
